{
  "name": "javabrew-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "description": "JavaBrew — PRO192 × JavaGuide Bilingual Learning Platform (EN / VI)",
  "scripts": {
    "dev": "node scripts/build-search-index.mjs && vite",
    "build": "node scripts/build-search-index.mjs && node scripts/build-sitemap.mjs && tsc -b && node scripts/build-api.mjs && vite build",
    "build:sitemap": "node scripts/build-sitemap.mjs",
    "optimize:media": "node scripts/optimize-media-webp.mjs --dry-run",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:content": "node scripts/verify-pro192.mjs && node scripts/check-links.mjs",
    "verify:translations": "node scripts/verify-translations.mjs",
    "verify:java": "node scripts/verify-java-runtime.mjs",
    "build:index": "node scripts/build-search-index.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@gsap/react": "^2.1.2",
    "@lezer/highlight": "^1.2.5",
    "@vercel/functions": "^3.11.3",
    "@vercel/sandbox": "^4.1.0",
    "gsap": "^3.15.1",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.1.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.6.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.4",
    "@vitejs/plugin-react": "^4.5.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  },
  "overrides": {
    "zod": "^4.6.7"
  }
}
