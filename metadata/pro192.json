  "peChallenges": [
    {
      "id": 1,
      "code": "PE 01",
      "cat": "oop",
      "title": "Quản lý Sinh viên OOP & Lọc GPA",
      "meta": "Dạng Q1–Q2 • Cơ bản • 25 phút",
      "relatedSlots": [
        12,
        13,
        25,
        27
      ],
      "desc": "Viết lớp Student đóng gói hợp lệ và hàm lọc danh sách sinh viên có GPA >= 8.0, xử lý an toàn trường hợp danh sách null/rỗng và sắp xếp giảm dần theo GPA.",
      "checklist": [
        "Đúng constructor & getter/setter kiểm tra biên [0.0, 10.0] (3đ)",
        "Xử lý an toàn null / danh sách rỗng (3đ)",
        "Sắp xếp & Output chuẩn định dạng Test Case (4đ)"
      ],
      "entityFileName": "Student.java",
      "entityCode": "public class Student {\n    private String name;\n    private double gpa;\n\n    public Student(String name, double gpa) {\n        this.name = (name == null) ? \"\" : name.trim();\n        this.gpa = (gpa >= 0.0 && gpa <= 10.0) ? gpa : 0.0;\n    }\n\n    public String getName() { return name; }\n    public double getGpa() { return gpa; }\n\n    public void setGpa(double gpa) {\n        if (gpa >= 0.0 && gpa <= 10.0) {\n            this.gpa = gpa;\n        }\n    }\n\n    @Override\n    public String toString() {\n        return String.format(\"%s - %.2f\", name, gpa);\n    }\n}",
      "starterCode": "import java.util.*;\n\npublic class Main {\n    public static List<Student> filterHonor(List<Student> list) {\n        List<Student> result = new ArrayList<>();\n        // Bẫy PE: Chưa kiểm tra list == null và phần tử s == null!\n        for (Student s : list) {\n            if (s.getGpa() >= 8.0) {\n                result.add(s);\n            }\n        }\n        return result;\n    }\n}",
      "cleanCode": "import java.util.*;\n\npublic class Main {\n    public static List<Student> filterHonor(List<Student> list) {\n        if (list == null || list.isEmpty()) {\n            return Collections.emptyList();\n        }\n        List<Student> result = new ArrayList<>();\n        for (Student s : list) {\n            if (s != null && s.getGpa() >= 8.0) {\n                result.add(s);\n            }\n        }\n        result.sort(Comparator.comparingDouble(Student::getGpa).reversed()\n                .thenComparing(Student::getName));\n        return result;\n    }\n}"
