      "entityFileName": "Item.java",
      "entityCode": "public class Item {\n    protected int value;\n    protected String creator;\n\n    public Item(int value, String creator) {\n        this.value = Math.max(0, value);\n        this.creator = (creator == null) ? \"\" : creator.trim();\n    }\n\n    public int getValue() { return value; }\n    public String getCreator() { return creator; }\n}",
      "starterCode": "public class ItemList {\n    private final Item[] list;\n    private int numOfItem;\n    public static final int MAX = 100;\n\n    public ItemList() {\n        this.list = new Item[MAX];\n    }\n\n    public boolean addItem(Item item) {\n        // Bẫy HTML cũ: không kiểm tra item == null và numOfItem >= MAX\n        list[numOfItem++] = item;\n        return true;\n    }\n}",
      "cleanCode": "public class ItemList {\n    private final Item[] list;\n    private int numOfItem;\n    public static final int MAX = 100;\n\n    public ItemList() {\n        this.list = new Item[MAX];\n        this.numOfItem = 0;\n    }\n\n    public boolean addItem(Item item) {\n        if (item == null || numOfItem >= MAX) return false;\n        list[numOfItem++] = item;\n        return true;\n    }\n\n    public int findItemIndex(String creator) {\n        if (creator == null) return -1;\n        for (int i = 0; i < numOfItem; i++) {\n            if (list[i].getCreator().equalsIgnoreCase(creator.trim())) return i;\n        }\n        return -1;\n    }\n\n    public boolean removeItem(int index) {\n        if (index < 0 || index >= numOfItem) return false;\n        for (int i = index; i < numOfItem - 1; i++) {\n            list[i] = list[i + 1];\n        }\n        list[--numOfItem] = null;\n        return true;\n    }\n\n    public void sortByValueAsc() {\n        for (int i = 0; i < numOfItem - 1; i++) {\n            for (int j = i + 1; j < numOfItem; j++) {\n                if (list[i].getValue() > list[j].getValue()) {\n                    Item tmp = list[i]; list[i] = list[j]; list[j] = tmp;\n                }\n            }\n        }\n    }\n}"
