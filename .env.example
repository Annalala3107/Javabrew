# Automatic AI Mentor Server Key (zero-config for students on Vercel & npm run dev)
GEMINI_API_KEY=
# Optional default server model: "gemini-3.5-flash-lite" (default, fastest/cheapest) or "gemini-4-hydrogen"
GEMINI_DEFAULT_MODEL=gemini-3.5-flash-lite
# Optional daily free AI quota per IP (default: 30)
AI_DAILY_LIMIT=30

# Optional Upstash Redis REST for distributed rate limiting & daily AI quota
# (gracefully falls back to in-memory buckets when unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional extra comma-separated allowed Origins for POST /api/*
ALLOWED_ORIGINS=

# Optional External Java Compiler Fallback (when Vercel Sandbox OIDC is unavailable)
# Supported providers: "piston" (supports multi-file natively) or "judge0"
# Example self-hosted Piston endpoint: https://piston.your-domain.com
# Example Judge0 CE endpoint: https://judge0-ce.p.rapidapi.com
JAVA_RUNNER_URL=
JAVA_RUNNER_PROVIDER=
JAVA_RUNNER_API_KEY=
# Judge0 Java language ID (default: 91 = Java JDK 17; 62 = OpenJDK 13)
JUDGE0_JAVA_LANGUAGE_ID=91

# Supabase Authentication (Client-side public URL & anon/publishable key)
# Leave blank to run in open local/test mode; set both to enable login/register gate
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
